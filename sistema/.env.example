# Copie para apps/web/.env.local e apps/admin/.env.local. Nunca faça commit de .env.
# URL das Edge Functions do projeto Supabase (sa-east-1), sem barra no fim.
SUPABASE_FUNCTIONS_URL=https://<projeto>.supabase.co/functions/v1
# Segredo de repasse (G1): o mesmo valor vai para as Edge Functions (supabase secrets set REPASSE_SEGREDO=...).
# Gere com: openssl rand -base64 48
REPASSE_SEGREDO=
# Origem das fotos no Supabase Storage: CSP img-src da loja e do painel e connect-src do
# painel (envio das fotos direto ao Storage pela URL assinada).
ORIGEM_IMAGENS=https://<projeto>.supabase.co
# 1 liga a página interna /_componentes num build de produção (só CI e testes).
MOSTRAR_COMPONENTES=
# Chave pública do Turnstile (Cloudflare) do painel e da loja (pedido de código); a secreta vai só para as Edge Functions
# (supabase secrets set TURNSTILE_SECRET=...).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# WhatsApp da loja (só dígitos, com 55), para o link "Receber código no WhatsApp" da loja.
# A api-public devolve o mesmo link; este vale se a cliente recarregar a tela do código.
WHATSAPP_LOJA=5577998155772

# Monitoramento (opcional): erros sem dados pessoais no Sentry ou compatível
SENTRY_DSN=
AMBIENTE=desenvolvimento
